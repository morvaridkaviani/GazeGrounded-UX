# Copy to `.env` and fill in only what you use. `.env` is git-ignored.
# Nothing here is needed for the synthetic demo (which uses the mock VLM provider).

# Optional: VLM served behind a chat-completions API (vlm.provider: http), e.g. a local
# Ollama / vLLM / LM Studio server. Leave the key empty for local servers that don't need one.
VLM_API_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=

# Optional: Hugging Face token for gated models (vlm.provider: local)
HF_TOKEN=
